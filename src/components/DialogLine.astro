---
interface Props {
	speaker: string;
	text?: string;
}

const { speaker, text } = Astro.props;
const normalizedSpeaker = speaker.toLowerCase();
const isBrain =
	normalizedSpeaker === "mozg" ||
	normalizedSpeaker === "mózg" ||
	normalizedSpeaker === "brain";
const hasContentSlot = Astro.slots.has("default");
---

<div class:list={["dialog-line", { "dialog-line--brain": isBrain }]}> 
	<p class="dialog-line__speaker">{speaker}</p>
	{
		hasContentSlot ? (
			<div class="dialog-line__text">
				<slot />
			</div>
		) : (
			<p class="dialog-line__text">{text}</p>
		)
	}
</div>
